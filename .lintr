linters: linters_with_defaults(
    line_length_linter(100),
    object_name_linter(styles = c("snake_case", "dotted.case", "camelCase", "UPPERCASE", "symbols"))
  )
exclusions: list(
    # Original code by the package author. Style is intentionally preserved as
    # written; correctness is still covered by R CMD check's code analysis.
    "R/Financial.R",
    "R/Multivariate.R",
    "R/Smoothing.R",
    "R/timeSeries.R",
    "R/Univariate.R"
  )
encoding: "UTF-8"
