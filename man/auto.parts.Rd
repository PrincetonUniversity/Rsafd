\name{auto.parts}
\alias{auto.parts}
\title{Daily stock closing prices for two auto parts companies}
\description{
Daily closing prices of two auto part companies, Advanced Auto Parts Inc. (AAP) and AutoZOne Inc. (AZO). This is a subset of the data set \code{stocks} and for that reason, the dates start on May 18, 2012, day of Facebook's IPO.}
\usage{data(auto.parts)}
\author{Rene Carmona, \email{rcarmona@princeton.edu}}
\examples{
head(auto.parts)
}
\keyword{datasets}
\format{
  A numerical data matrix with 2170 rows and 2 columns (one for each stock). The column names are the tickers of the stocks and the row names are the dates.
}
