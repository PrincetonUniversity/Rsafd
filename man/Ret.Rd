\name{Ret}
\alias{Ret}
\title{
20 x 10 matrix used as illustration
}
\description{
Simulated data for 20 days of log-returns for 10 stocks.
}
\details{
Data used as illustration for the computation of the Value at Risk (VaR) of a large portfolio on p. 164 of the textbook "Statistical Analysis of Financial Data in R, (2014) Springer Verlag"
}
\examples{
plot(Ret[,1], type="l")
}
\keyword{datasets}
\format{
20 x 10 matrix
}
\source{
R. A. Carmona: Statistical Analysis of Financial Data in R, (2014) Springer Verlag}
