\name{CorrSwap.ts}
\alias{CorrSwap.ts}
\docType{data}
\title{Daily Values of BNP and Deutsche Bank}
\description{
Object of class \code{timeSeries} with two columns, \code{BNP} and \code{DBK}, used in the reference text.
}
\usage{
data(CorrSwap.ts)
}
\format{
An object of class \code{timeSeries} with 2076 daily observations of 2 variables (\code{BNP} and \code{DBK}) from 2000-01-03 to 2008-01-11.
}
\references{
R. A. Carmona: Statistical Analysis of Financial Data in R, (2014) Springer Verlag
}
\examples{
plot(CorrSwap.ts)
}
\keyword{datasets}
