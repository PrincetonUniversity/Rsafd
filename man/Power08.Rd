\name{Power08}
\alias{Power08}
\docType{data}
\title{Power08 Data}
\description{
Numeric matrix with one row per day of the year 2008 and two columns, used in the reference text.
}
\usage{
data(Power08)
}
\format{
A numeric matrix with 366 rows and 2 columns. The row names are the dates from 31.12.2008 down to 01.01.2008 (format day.month.year, in decreasing order).
}
\references{
R. A. Carmona: Statistical Analysis of Financial Data in R, (2014) Springer Verlag
}
\examples{
head(Power08)
}
\keyword{datasets}
