\name{co2.ts}
\alias{co2.ts}
\alias{CO2}
\docType{data}
\title{
CO2 concentration
}
\description{
Concentration of CO2 above the Mauna Loa volcano in Hawaii. The data comprise
monthly measurements. They range from March 1958 to December 2008
}
\usage{
data(co2.ts)
data(CO2)
}
\references{
 R.A. Carmona, Statistical Analysis of Financial Data in R, (2014), Springer Verlag
}
\examples{
plot(co2.ts)
}
\keyword{datasets}
\format{
The data set is an object of class timeSeries.
\code{CO2} is the numeric vector of length 610 of the data of \code{co2.ts}.}
